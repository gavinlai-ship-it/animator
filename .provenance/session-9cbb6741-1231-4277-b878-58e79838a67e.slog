{"data":{"content":"// Runs grading/*/autograder.mjs as ordinary (synchronous, from Gleam's point\n// of view) test checks: gleam test -- q13 shells out to each script and\n// throws if it exits non-zero, which grader.gleam's rescue() (a plain\n// try/catch, not Promise-aware) can catch correctly.\n\nimport { execFileSync } from \"node:child_process\";\nimport path from \"node:path\";\n\n// `gleam test` runs with cwd = the Gleam project directory, regardless of how\n// deep under build/ this compiled file actually sits -- import.meta.url would\n// point there, not at the source tree, so we don't use it for path resolution.\nconst PROJECT_ROOT = process.cwd();\n\n// `gleam test -- --verbose` turns on the progress traces below, and passes\n// --verbose on to each autograder so it prints its own.\nconst VERBOSE = process.argv.includes(\"--verbose\");\nconst VERBOSE_ARGS = VERBOSE ? [\"--verbose\"] : [];\n\n// A genuine hang never produces a traceback on its own (nothing has thrown\n// yet), so with --verbose, print progress as we go instead: if it does\n// stall, whatever printed last tells you which step it's stuck in.\nfunction trace(msg) {\n  if (!VERBOSE) return;\n  console.error(`[autograders ${new Date().toISOString()}] ${msg}`);\n}\n\n\n// Runs one autograder, keeping its report (grading/report.mjs) quiet unless\n// it fails. A failure is thrown shaped like a Gleam `panic`, carrying the\n// report as its message, so both gleeunit and grader.gleam print the report\n// as the test's failure instead of \"Command failed: node ...\".\nfunction runScript(relativeScriptPath, args) {\n  try {\n    const report = execFileSync(\n      process.execPath,\n      [path.join(PROJECT_ROOT, relativeScriptPath), ...args, ...VERBOSE_ARGS],\n      { cwd: PROJECT_ROOT, stdio: [\"ignore\", \"pipe\", \"inherit\"], encoding: \"utf8\" },\n    );\n    if (VERBOSE) process.stdout.write(report);\n  } catch (e) {\n    const report = (e.stdout ?? \"\").trim();\n    const error = new Error(\n      report !== \"\"\n        ? report\n        : `${relativeScriptPath} crashed before reporting any results (its error is printed above)`,\n    );\n    error.gleam_error = \"panic\";\n    error.file = relativeScriptPath;\n    error.line = 1;\n    throw error;\n  } finally {\n    trace(`${relativeScriptPath} finished`);\n  }\n}\n\n\n// This one checks the address that the student deployed to.\nexport function run_deployment_autograder(url) {\n  runScript(\"grading/deployment/autograder.mjs\", [url]);\n}\n\n// This one checks the student's video link, so it doesn't need a browser or the app.\nexport function run_video_autograder(url) {\n  runScript(\"grading/video/autograder.mjs\", [url]);\n}\n","line_count":66,"path":"test/autograders_ffi.mjs","sha256":"dc1aab8fe31277616060533835a1e33007f61bea6dd14ca6838ef099939e23fe"},"hash":"d23391c4a5782caa4f067a238658c6783c0c333cd6880dee463eab4abe0cd271","kind":"doc.open","prev_hash":"faab42dbdab512e0132b861830855c05f0851d3b4de90045012980de3d6e8b83","seq":30,"t":21144,"wall":"2026-11-18T18:16:41.859Z"}
{"data":{"path":"test/autograders_ffi.mjs"},"hash":"9be1d2ec3a4b303ba7b7371b6ec26d9cd552592a857b4c72ce0ed0e738a35c1d","kind":"doc.close","prev_hash":"d23391c4a5782caa4f067a238658c6783c0c333cd6880dee463eab4abe0cd271","seq":31,"t":21726,"wall":"2026-11-18T18:16:42.441Z"}
{"data":{"content":"//// The test entry point: which tests belong to which question of the project.\n////\n//// `gleam test` runs every test in this directory with gleeunit, as usual;\n//// `gleam test -- q1` runs one question's tests and `gleam test -- score`\n//// reports every question's. grader.gleam is the whole of that machinery.\n//// Problems 9 to 11 are scored on Gradescope, by tests that aren't distributed with\n//// the project. The tests for q9 to q11 here only check that the app has the elements\n//// that Gradescope's tests look for (test_ids_test.gleam), so they are worth no points\n//// here. The checks in autograders.gleam are untimed_checks, since they can take far\n//// longer than the grader's timeout. The test for q12 only checks that extension.txt\n//// has been filled in, so it's worth no points.\n////\n//// The tests of Phase 1's questions are listed in interpreter_questions.gleam, which\n//// proj/animator-ts shares.\n\nimport autograders\nimport extension_test as extension\nimport gleam/list\nimport grader.{check, question, untimed_check}\nimport interpreter_questions\nimport test_ids_test as test_ids\n\npub fn main() -> Nil {\n  grader.main(\n    list.append(interpreter_questions.all(), [\n      question(\"q9\", 0, [\n        check(\"canvas_id_test\", test_ids.canvas_id_test),\n        check(\"code_editor_id_test\", test_ids.code_editor_id_test),\n      ]),\n      question(\"q10\", 0, [\n        check(\"shape_slider_id_test\", test_ids.shape_slider_id_test),\n        check(\"speed_slider_id_test\", test_ids.speed_slider_id_test),\n      ]),\n      question(\"q11\", 0, [\n        check(\"drawing_select_id_test\", test_ids.drawing_select_id_test),\n      ]),\n      question(\"q12\", 0, [\n        check(\"extension_description_test\", extension.description_test),\n      ]),\n      question(\"q13\", 1, [\n        untimed_check(\n          \"deployment_autograder_test\",\n          autograders.deployment_autograder_test,\n        ),\n      ]),\n      question(\"q14\", 1, [\n        untimed_check(\n          \"video_autograder_test\",\n          autograders.video_autograder_test,\n        ),\n      ]),\n    ]),\n  )\n}\n","line_count":55,"path":"test/animator_test.gleam","sha256":"2bacb79ba2c8fb5b796f965994fa6e74f8b0c8b03cef7f66edc77199b1330ae8"},"hash":"406f6b986c9a0e6a1def0a796a75162240996efb431d8c2b81b8248838b01b37","kind":"doc.open","prev_hash":"9be1d2ec3a4b303ba7b7371b6ec26d9cd552592a857b4c72ce0ed0e738a35c1d","seq":32,"t":21732,"wall":"2026-11-18T18:16:42.446Z"}
