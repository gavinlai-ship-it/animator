{"data":{"command":"urrency:\n  group: pages\n  cancel-in-progress: true\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: erlef/setup-beam@v1\n        with:\n          otp-version: \"27\"\n          gleam-version: \"1.14.0\"\n      - run: gleam build\n      - name: Assemble site\n        run: |\n          mkdir -p dist/build/dev\n          cp index.html animator.css dist/\n          cp -r build/dev/javascript dist/build/dev/javascript\n          touch dist/.nojekyll\n      - uses: actions/upload-pages-artifact@v3\n        with:\n          path: dist\n\n  deploy:\n    needs: build\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - id: deployment\n        uses: actions/deploy-pages@v4\nEOF\ngavinlai@Gavins-MacBook-Pro-853 animator % head -5 .github/workflows/deploy.yml\nname: Deploy to GitHub Pages\n\non:\n  push:\n    branches: [main]\ngavinlai@Gavins-MacBook-Pro-853 animator % gleam --version","exit_code":127,"terminal_id":"term-0"},"hash":"85f4b242c47c97af5079963cc1f5cdf539dd58ee13c016d340c7d12c3ee66e64","kind":"terminal.command","prev_hash":"895f2f3690dd3e51856567efaae61c6b6204035edc88578e8e9910b1ae1378b7","seq":25318,"t":363396652,"wall":"2026-11-22T23:12:56.232Z"}
