{"data":{"command":"name: Deploy to GitHub Pages\n\non:\n  push:\n    branches: [main]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\nconcurrency:\n  group: pages\n  cancel-in-progress: true\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: erlef/setup-beam@v1\n        with:\n          otp-version: \"27\"\n          gleam-version: \"1.14.0\"\n      - run: gleam build\n      - name: Assemble site\n        run: |\n          mkdir -p dist/build/dev\n          cp index.html animator.css dist/\n          cp -r build/dev/javascript dist/build/dev/javascript\n          touch dist/.nojekyll\n      - uses: actions/upload-pages-artifact@v3\n        with:\n          path: dist\n\n  deploy:\n    needs: build\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - id: deployment\n        uses: actions/deploy-pages@v4","exit_code":127,"terminal_id":"term-0"},"hash":"c6a529f20386508ff719d17192b05b9be383dc870877a7b020c0a57cd83a5c42","kind":"terminal.command","prev_hash":"74bf95aefb36702228f3741476690c0966b9f9583b3389162d45f1766c55de92","seq":25287,"t":363305308,"wall":"2026-11-22T23:11:24.888Z"}
