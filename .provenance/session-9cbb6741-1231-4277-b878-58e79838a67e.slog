{"data":{"content":"// The interpreter's limits. Counting steps uses mutation, and both limits end an\n// evaluation by unwinding the JavaScript stack, so this is written in JavaScript.\n\n// The most steps a whole evaluation may spend, across every branch. Sized so that\n// even a program that spends them all on the interpreter's slowest operations\n// finishes in well under a tenth of a second.\nconst STEP_LIMIT = 250000;\n\nconst OUT_OF_STEPS = {};\n\nlet steps = 0;\n\nexport function charge(cost) {\n  steps += Math.max(cost, 0);\n  if (steps > STEP_LIMIT) throw OUT_OF_STEPS;\n}\n\nexport function guarded(evaluate, stepError, recursionError) {\n  steps = 0;\n  try {\n    return evaluate();\n  } catch (error) {\n    if (error === OUT_OF_STEPS) return stepError;\n    // A stack overflow is a RangeError in Chrome and Safari, and an InternalError\n    // in Firefox.\n    if (error instanceof RangeError || error?.name === \"InternalError\") {\n      return recursionError;\n    }\n    throw error;\n  }\n}\n","line_count":32,"path":"src/limits_ffi.mjs","sha256":"fd7b70d63171b330748698905f29e3ef0a763ce4dc4d6f7a1dcf6576ac5483c5"},"hash":"1ae279a3dda34c211151011542b78c29805efcc1e20f9553f3d6fe5553d0a2a5","kind":"doc.open","prev_hash":"82035e6fd3839ef14d811c20cdcc2a8d8bbdcd07f4900471a6bfff6ac5d5f6ca","seq":6543,"t":211288250,"wall":"2026-11-21T04:57:48.380Z"}
{"data":{"path":"src/limits_ffi.mjs"},"hash":"999e3157553ab367f3356cf1c1a9e09120ed9063cc3fb121fe39f59631877bd8","kind":"doc.close","prev_hash":"1ae279a3dda34c211151011542b78c29805efcc1e20f9553f3d6fe5553d0a2a5","seq":6544,"t":211289430,"wall":"2026-11-21T04:57:49.560Z"}
{"data":{"content":"//// The errors of the draw language: everything that can go wrong while\n//// evaluating user-submitted code, and the message shown for each.\n//// evaluator.gleam, builtins.gleam, and limits.gleam all produce these;\n//// the app catches them at the boundary (try_draw's callers), so user code\n//// can never crash the app.\n\nimport gleam/int\n\npub type EvalError {\n  // A name that isn't bound.\n  UnboundVariable(name: String)\n  // A built-in received arguments of the wrong type.\n  TypeError(message: String)\n  // A case whose patterns did not cover this value.\n  NoMatchingCase\n  // Recursion overflowed the stack.\n  RecursionLimit\n  // Evaluation exceeded the limit on the amount of processing.\n  StepLimit\n  // The finished drawing had more paths than the animator will render.\n  PathLimit\n  // The program has no function by this name that takes num_args arguments.\n  MissingFunction(name: String, num_args: Int)\n  // The finished drawing is not a well formed list of paths.\n  BadDrawing(message: String)\n  // Only used during development to mark parts that aren't implemented yet.\n  NotImplemented(expr: String)\n  // An error in an expression on this source line (see at_line).\n  OnLine(error: EvalError, line: Int)\n}\n\n/// The error located on line. An error passes through the line marker of each\n/// expression it is inside, and the first is closest to the problem, so it is the\n/// one that counts.\npub fn at_line(error: EvalError, line: Int) -> EvalError {\n  case error {\n    OnLine(..) -> error\n    _ -> OnLine(error, line)\n  }\n}\n\n/// A human-readable description of an evaluation error, to show the user: what\n/// went wrong and, if it's known, where, e.g. `unknown variable: pt on line 4`.\npub fn error_message(error: EvalError) -> String {\n  case error {\n    UnboundVariable(name) -> \"unknown variable: \" <> name\n    TypeError(message) -> \"type error: \" <> message\n    NoMatchingCase -> \"no case pattern matched the value\"\n    MissingFunction(name, num_args) ->\n      \"no function \"\n      <> name\n      <> \" that takes \"\n      <> int.to_string(num_args)\n      <> \" argument(s)\"\n    BadDrawing(message) -> \"bad drawing: \" <> message\n    RecursionLimit -> \"recursion too deep (missing base case?)\"\n    StepLimit -> \"too many steps (drawing too complex, or infinite loop?)\"\n    PathLimit -> \"too many paths in the drawing\"\n    NotImplemented(expr) -> \"not yet implemented: \" <> expr\n    OnLine(error, line) -> error_message(error) <> on_line(line)\n  }\n}\n\n/// \" on line 4\": where an error is, as every message that has a line ends. The\n/// parser ends its own errors this way too.\npub fn on_line(line: Int) -> String {\n  \" on line \" <> int.to_string(line)\n}\n","line_count":69,"path":"src/errors.gleam","sha256":"81efc7d575024033eeacb46b3335375ba9ba7f429c184ab3c2dc72018b32921b"},"hash":"09988e08bdd69197f0be257f24cc57eef1ff8b1073a089dd9006350e0ea9c720","kind":"doc.open","prev_hash":"999e3157553ab367f3356cf1c1a9e09120ed9063cc3fb121fe39f59631877bd8","seq":6545,"t":211289443,"wall":"2026-11-21T04:57:49.572Z"}
{"data":{"path":"src/errors.gleam"},"hash":"a2908349f918330cfdc90a9a19ffd1260dd98f56da8327c480732ac2d9baaf9a","kind":"doc.close","prev_hash":"09988e08bdd69197f0be257f24cc57eef1ff8b1073a089dd9006350e0ea9c720","seq":6546,"t":211289960,"wall":"2026-11-21T04:57:50.089Z"}
{"data":{"content":"//// The draw-function code pane: the CodeMirror FFI glue and the side-by-side\n//// panel view. app wires the editor's messages through the generic msg-typed\n//// helpers here, so this module never depends back on app.\n\nimport gleam/list\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\n\n// ── CodeMirror FFI ──────────────────────────────────────────────────────────\n\n@external(javascript, \"./editor_ffi.mjs\", \"mountEditor\")\nfn do_mount(text: String, on_change: fn(String) -> Nil) -> Nil\n\n/// Mount a CodeMirror editor showing text, routing every edit through on_change.\n/// Mounting tears down any previous editor itself, so re-mounting just calls this\n/// again — there is no separate unmount.\n/// Mounting an editor doesn't change the animation. To animate the text in a\n/// new editor, the caller has to update the animation too.\npub fn mount(text: String, on_change: fn(String) -> msg) -> Effect(msg) {\n  effect.from(fn(dispatch) { do_mount(text, fn(t) { dispatch(on_change(t)) }) })\n}\n\n// ── View ──────────────────────────────────────────────────────────────────────\n\n/// The code panel that sits beside the drawing: the live editor and a reference\n/// of the built-in inputs and functions. The latest code that runs is rendered\n/// continuously, so there is no explicit apply step.\npub fn view_panel(on_collapse: msg) -> Element(msg) {\n  html.div([attr.class(\"code-panel\")], [\n    html.div([attr.class(\"code-header\")], [\n      html.span([attr.class(\"code-title\")], [html.text(\"draw code\")]),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.attribute(\"title\", \"Hide code\"),\n          event.on_click(on_collapse),\n        ],\n        [html.text(\"⟨\")],\n      ),\n    ]),\n    // The editor fills this wrapper.\n    html.div([attr.class(\"code-editor-wrap\")], [\n      // CodeMirror mounts into this node (see mount). It is rendered as\n      // unsafe_raw_html with constant empty content so Lustre never\n      // re-patches it and the editor DOM survives re-renders.\n      element.unsafe_raw_html(\n        \"\",\n        \"div\",\n        [attr.id(\"code-editor\"), attr.class(\"code-editor\")],\n        \"\",\n      ),\n    ]),\n    view_reference_panel(),\n  ])\n}\n\n// ── Built-in reference ──────────────────────────────────────────────────────\n\n// One entry in the reference panel: a signature (monospace) and a plain-English\n// description.\ntype RefEntry {\n  RefEntry(signature: String, description: String)\n}\n\nfn inputs() -> List(RefEntry) {\n  [\n    RefEntry(\"shape_slider: Int\", \"the shape slider value, in [0, 100]\"),\n  ]\n}\n\nfn functions() -> List(RefEntry) {\n  [\n    RefEntry(\"random(min: Int, max: Int) -> Int\", \"a random int in [min, max)\"),\n    RefEntry(\"abs(n: Int) -> Int\", \"the absolute value of `n`\"),\n    RefEntry(\n      \"Point(x: Int, y: Int)\",\n      \"a point on the canvas: (0, 0) is the center, x and y run from -500 to 500, and y grows downward\",\n    ),\n    RefEntry(\"Line(start: Point, end: Point)\", \"a straight-line shape\"),\n    RefEntry(\n      \"Path(shape, start: Int, end: Int, thickness: Int)\",\n      \"draws a shape between times `start` and `end`, in 1/10 s (end <= start draws it instantly)\",\n    ),\n  ]\n}\n\n// The gleam/list functions the language supports, under their real names. A\n// fn(...) below is any function: a fn(x) { ... } written on the spot, a\n// helper's name, or a capture like add(1, _).\nfn list_functions() -> List(RefEntry) {\n  [\n    RefEntry(\n      \"list.map(list, fn(a) -> b) -> List(b)\",\n      \"each element through `fn`\",\n    ),\n    RefEntry(\n      \"list.filter(list, fn(a) -> Bool) -> List(a)\",\n      \"only the elements `fn` says True to\",\n    ),\n    RefEntry(\"list.append(list, list) -> List(a)\", \"one list after the other\"),\n    RefEntry(\"list.length(list) -> Int\", \"the number of elements\"),\n    RefEntry(\n      \"list.flatten(List(List(a))) -> List(a)\",\n      \"the inner lists, end to end\",\n    ),\n  ]\n}\n\n// A collapsible panel of the inputs and built-ins available to draw, with\n// their types/signatures. Uses native <details>/<summary> so it needs no model\n// state, and starts collapsed to leave more room for the editor.\nfn view_reference_panel() -> Element(msg) {\n  html.details([attr.class(\"reference\")], [\n    html.summary([attr.class(\"reference-summary\")], [\n      html.text(\"Built-ins\"),\n    ]),\n    html.div([attr.class(\"reference-body\")], [\n      ref_group(\"Inputs\", inputs()),\n      ref_group(\"Functions\", functions()),\n      ref_group(\"Lists\", list_functions()),\n    ]),\n  ])\n}\n\nfn ref_group(title: String, entries: List(RefEntry)) -> Element(msg) {\n  html.div([attr.class(\"reference-group\")], [\n    html.div([attr.class(\"reference-group-title\")], [html.text(title)]),\n    html.div(\n      [attr.class(\"reference-rows\")],\n      list.map(entries, fn(e) {\n        html.div([attr.class(\"reference-row\")], [\n          html.code([attr.class(\"reference-sig\")], [\n            html.text(e.signature),\n          ]),\n          html.span([attr.class(\"reference-desc\")], [\n            html.text(e.description),\n          ]),\n        ])\n      }),\n    ),\n  ])\n}\n","line_count":146,"path":"src/editor.gleam","sha256":"ba25f3dc932361ba7964be600ef8870ce4c9daf9ec9ea961df193b50267105e3"},"hash":"8de2d98a9f54b37df06a7ed7f51388f4aa19eb99c681e202ae802fc5658d8c74","kind":"doc.open","prev_hash":"a2908349f918330cfdc90a9a19ffd1260dd98f56da8327c480732ac2d9baaf9a","seq":6547,"t":211289968,"wall":"2026-11-21T04:57:50.098Z"}
